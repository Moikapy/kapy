{
  "name": "@moikapy/kapy-pub",
  "version": "0.1.0",
  "type": "module",
  "description": "Publish npm packages with confidence — verify builds, check contents, rotate encryption keys",
  "bin": {
    "kapy-pub": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "bun run --watch src/cli.ts",
    "build": "bun build src/index.ts src/cli.ts --outdir dist --target bun && tsc --emitDeclarationOnly --outDir dist",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@moikapy/kapy": "^0.3.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/bun": "^1.2.0"
  },
  "files": [
    "dist",
    "SKILL.md"
  ],
  "keywords": [
    "kapy",
    "npm",
    "publish",
    "package",
    "encryption",
    "key-rotation"
  ],
  "license": "MIT"
}